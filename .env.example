# Database
DATABASE_URL=postgresql://username:password@localhost:5432/vivk
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public Supabase variables (exposed to client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Authentication
NEXTAUTH_SECRET=your-nextauth-secret-key
NEXTAUTH_URL=http://localhost:3000

# Admin panel (/admin/login) - separate from user auth
# Generate the hash with: node scripts/hash-admin-password.js
ADMIN_EMAIL=admin@vivk.in
ADMIN_PASSWORD_HASH=base64-encoded-bcrypt-hash
ADMIN_SESSION_SECRET=random-32-plus-char-secret-different-from-NEXTAUTH_SECRET

# AI Integration
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
CUSTOM_AI_API_KEY=your-custom-ai-api-key
AI_PROVIDER=anthropic
GROQ_API_KEY=gsk_your-groq-key
# Encrypts the extra AI keys added in Admin > AI Keys (random, 32+ chars; changing it makes saved keys unreadable)
AI_KEYS_SECRET=random-32-plus-char-secret
# Optional Anthropic model overrides
# ANTHROPIC_MODEL_FREE=
# ANTHROPIC_MODEL_PRO=
# ANTHROPIC_MODEL_BUSINESS=

# Payments
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
RAZORPAY_PRO_PLAN_ID=plan_pro_monthly
RAZORPAY_BUSINESS_PLAN_ID=plan_business_monthly

# Caching
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Email
RESEND_API_KEY=your-resend-api-key

# App Configuration
NODE_ENV=development